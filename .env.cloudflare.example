# Cloudflare Pages 构建环境变量（在 CF Dashboard 设置，勿提交密钥）

# 方式 A：前端直连后端公网地址
VITE_API_BASE_URL=https://api.yourdomain.com

# 方式 B：同域反代（配合 functions/api/[[path]].js）
# VITE_API_BASE_URL 留空，Pages 环境变量设置:
# BACKEND_URL=https://api.yourdomain.com

# 前端公开配置（非密钥）
VITE_ENABLE_AI_RECOMMENDATIONS=true
VITE_ENABLE_AI_ANALYSIS=true
VITE_UI_THEME=light

# DeepSeek 密钥仅放后端 server/.env，不要设置 VITE_DEEPSEEK_API_KEY
