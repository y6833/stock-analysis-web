# Oracle Cloud 部署环境变量
# 复制为 .env.oracle 并修改所有 CHANGE_ME 项

# ================================
# 数据库（Docker 内部服务名 mysql / redis）
# ================================
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
DB_NAME=stock_analysis
DB_USER=stock_user
DB_PASSWORD=CHANGE_ME_db_password

# ================================
# JWT（生产必改）
# ================================
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars

# ================================
# CORS — Cloudflare Pages 与自定义域名（逗号分隔，无空格）
# ================================
ALLOWED_ORIGINS=https://stock-analysis-web.pages.dev,https://你的域名.com

# ================================
# DeepSeek AI（仅服务端）
# ================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ================================
# 数据源（按需填写）
# ================================
TUSHARE_TOKEN=

# ================================
# Egg 生产环境
# ================================
NODE_ENV=production
EGG_SERVER_ENV=prod
