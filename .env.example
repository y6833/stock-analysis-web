# DeepSeek API Configuration
VITE_DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
VITE_DEEPSEEK_MODEL=deepseek-chat
VITE_DEEPSEEK_MAX_TOKENS=4000
VITE_DEEPSEEK_TEMPERATURE=0.7
VITE_DEEPSEEK_TOP_P=0.9
VITE_DEEPSEEK_RATE_LIMIT=60
VITE_DEEPSEEK_DAILY_LIMIT=1000
VITE_DEEPSEEK_RETRY_COUNT=3
VITE_DEEPSEEK_TIMEOUT=30000
VITE_DEEPSEEK_DEBUG=true
VITE_DEEPSEEK_ENABLE_CACHE=true
VITE_DEEPSEEK_CACHE_TIMEOUT=300000

# AI Features Configuration
VITE_ENABLE_AI_RECOMMENDATIONS=true
VITE_ENABLE_AI_ANALYSIS=true
VITE_ENABLE_REALTIME_INSIGHTS=true

# Existing configuration...
VITE_API_BASE_URL=http://localhost:7001
VITE_WS_BASE_URL=ws://localhost:7001
VITE_ENABLE_MOCK=false
VITE_ENABLE_DEBUG=true
VITE_LOG_LEVEL=info

# Tushare API Configuration
VITE_TUSHARE_API_TOKEN=your-tushare-token-here
VITE_TUSHARE_BASE_URL=http://api.tushare.pro
VITE_TUSHARE_PROXY_URL=/api/tushare
VITE_TUSHARE_RATE_LIMIT=200
VITE_TUSHARE_DAILY_LIMIT=500
VITE_TUSHARE_RETRY_COUNT=3